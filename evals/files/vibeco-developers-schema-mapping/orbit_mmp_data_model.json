{
  "_about": "Fictional fixture. Orbit Attribution is an imaginary mobile measurement partner (MMP) that is not yet a Vibe partner. Its conventions deliberately mirror AppsFlyer's real attribution-link parameters (pid, c, af_c_id, af_adset, af_adset_id, af_ad, af_ad_id, af_siteid, af_sub1-5, af_viewthrough_lookback) so the case stays realistic.",
  "entities": {
    "App": {
      "description": "An advertiser's app registered in Orbit.",
      "fields": {
        "app_id": "string (store id, e.g. 'id1488123456' for iOS, 'com.fitpulse.app' for Android)",
        "platform": "enum[ios, android]",
        "store_url": "url",
        "timezone": "IANA tz (reporting + cohorts)",
        "currency": "ISO-4217 (revenue currency of the app)"
      }
    },
    "MediaSource": {
      "description": "An integrated ad network/partner. Identified by 'pid' on every link.",
      "fields": {
        "pid": "string (e.g. 'vibe_int')",
        "name": "string",
        "supports_view_through": "bool",
        "cost_ingestion": "enum[none, api_pull, partner_push]"
      }
    },
    "TrackingLink": {
      "description": "Click and impression URLs the partner fires. Macros are filled by the partner's ad server.",
      "fields": {
        "click_url_template": "https://app.orbit-attr.example/{app_id}?pid=vibe_int&c={campaign_name}&af_c_id={campaign_id}&af_adset={adset_name}&af_adset_id={adset_id}&af_ad={ad_name}&af_ad_id={ad_id}&af_siteid={site_id}&idfa={idfa}&gaid={gaid}",
        "impression_url_template": "https://impression.orbit-attr.example/{app_id}?pid=vibe_int&c={campaign_name}&af_c_id={campaign_id}&af_adset_id={adset_id}&af_ad_id={ad_id}&af_siteid={site_id}&af_ip={ip}&af_ua={user_agent}&af_viewthrough_lookback=1d",
        "matching_methods": "enum[] — [device_id, probabilistic_ip_ua]  (default priority: device_id first)"
      }
    },
    "Touchpoint": {
      "description": "One click or impression received from a partner.",
      "fields": {
        "type": "enum[click, impression]",
        "ts": "timestamp",
        "ip": "string",
        "user_agent": "string",
        "idfa": "string | null",
        "gaid": "string | null",
        "link_params": "map (c, af_c_id, af_adset_id, af_ad_id, af_siteid, af_sub1..5)"
      }
    },
    "Install": {
      "description": "Attributed first open.",
      "fields": {
        "orbit_id": "string",
        "app_id": "string",
        "install_ts": "timestamp",
        "media_source": "pid | 'organic'",
        "attributed_touch_type": "enum[click, impression]",
        "match_type": "enum[device_id, probabilistic, skan]",
        "campaign_id": "string",
        "adset_id": "string",
        "ad_id": "string",
        "site_id": "string",
        "is_reengagement": "bool",
        "skan_conversion_value": "int 0-63 | null (iOS SKAdNetwork)"
      }
    },
    "InAppEvent": {
      "description": "Post-install event sent by the app SDK.",
      "fields": {
        "orbit_id": "string",
        "event_name": "string (free-form, defined by the app)",
        "event_ts": "timestamp",
        "revenue": "decimal | null",
        "currency": "ISO-4217"
      }
    },
    "PartnerPostback": {
      "description": "What Orbit forwards to a partner after attribution.",
      "fields": {
        "events_scope": "enum[attributed_to_partner_only, all_media_sources]",
        "event_mapping": "map orbit event_name -> partner event name",
        "include_revenue": "bool",
        "payload_fields": "string[] (install_ts, event_name, revenue, currency, campaign_id, adset_id, ad_id, site_id, attributed_touch_type, match_type)"
      }
    },
    "CostRecord": {
      "description": "Daily cost pulled from the partner's API, joined to installs on (campaign_id, adset_id, ad_id, site_id, date).",
      "fields": {
        "date": "date (app timezone)",
        "pid": "string",
        "campaign_id": "string",
        "adset_id": "string",
        "ad_id": "string",
        "site_id": "string",
        "cost": "decimal",
        "cost_currency": "ISO-4217",
        "impressions": "int",
        "clicks": "int"
      }
    },
    "CohortReport": {
      "description": "Orbit's headline ROAS: revenue generated by users who installed on day X, divided by cost of day X.",
      "fields": {
        "install_date": "date",
        "pid": "string",
        "campaign_id": "string",
        "adset_id": "string",
        "ad_id": "string",
        "installs": "int",
        "cost": "decimal",
        "revenue_d0": "decimal",
        "revenue_d7": "decimal",
        "revenue_d30": "decimal",
        "roas_d7": "decimal",
        "cpi": "decimal",
        "retention_d1": "decimal",
        "retention_d7": "decimal"
      }
    }
  },
  "sample_integration": {
    "advertiser_app": {
      "app_id": "id1488123456",
      "platform": "ios",
      "store_url": "https://apps.apple.com/app/id1488123456",
      "timezone": "America/Chicago",
      "currency": "EUR"
    },
    "planned_postback": {
      "events_scope": "attributed_to_partner_only",
      "include_revenue": true,
      "event_mapping": {
        "install": "install",
        "start_trial": "?",
        "subscribe": "?",
        "iap_purchase": "?",
        "level_10": "?"
      }
    },
    "orbit_default_settings_for_new_partners": {
      "af_viewthrough_lookback": "1d",
      "matching_priority": [
        "device_id",
        "probabilistic_ip_ua"
      ],
      "cost_ingestion": "api_pull",
      "cost_pull_frequency": "hourly, last 7 days rolling"
    },
    "sample_install_from_vibe": {
      "orbit_id": "o_93f1",
      "install_ts": "2026-11-03T21:14:00-06:00",
      "media_source": "vibe_int",
      "attributed_touch_type": "impression",
      "match_type": "probabilistic",
      "campaign_id": "?",
      "adset_id": "?",
      "ad_id": "?",
      "site_id": "?",
      "skan_conversion_value": 12
    }
  }
}